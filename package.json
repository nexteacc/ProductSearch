{
  "name": "product-research-local",
  "productName": "Product Search",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run build && electron .",
    "package": "node scripts/build.mjs --release && node scripts/package.mjs",
    "mcp": "node dist/mcp.cjs",
    "format": "prettier --write src tests scripts DESIGN.md UX-CONTRACT.md tsconfig.json package.json premium-ui.json",
    "format:check": "prettier --check src tests scripts DESIGN.md UX-CONTRACT.md tsconfig.json package.json premium-ui.json"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "22.18.6",
    "axe-core": "4.13.0",
    "electron": "44.5.1",
    "esbuild": "0.25.10",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
